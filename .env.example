# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAT_ACCESS_TOKEN=
PI_PROVIDER=openai
PI_MODEL=gpt-4o-mini
# Set your own model-provider key here, never commit .env
PI_API_KEY=
PORT=3000
HOST=127.0.0.1
# Set true behind HTTPS. Keep false only for localhost HTTP.
COOKIE_SECURE=false

# Default: actual dot bridge. No model fallback or model API key is used.
CHAT_MODE=bridge
# Public canonical protected MCP resource URL, e.g. https://chat.example.com/mcp
MCP_RESOURCE_URL=
# Your OAuth 2.1 authorization server issuer and HTTPS JWKS endpoint
MCP_OAUTH_ISSUER=
MCP_JWKS_URL=
# The single owner's exact verified OAuth subject (sub)
MCP_OWNER_SUBJECT=
# Emergency stop for outgoing webhook delivery; restart after changing.
BRIDGE_DELIVERY_ENABLED=true
